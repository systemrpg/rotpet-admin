# =================================
# Rot Pet Shop Admin - Variables de entorno
# =================================

# Modo DB: "true" para usar Docker local con Postgres, "false" para Supabase Cloud
USE_LOCAL_DB=true

# Postgres local (Docker) - solo si USE_LOCAL_DB=true
DATABASE_URL=postgresql://rotpet:rotpet_secret_2024@localhost:5435/rotpet

# Supabase (REQUERIDO solo si USE_LOCAL_DB=false)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# URL del sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=

# Email - Resend (OPCIONAL)
RESEND_API_KEY=
EMAIL_FROM=Rot Pet Shop <noreply@rot.pet>
SUPPORT_EMAIL=info@rot.pet

# Google Analytics (OPCIONAL)
NEXT_PUBLIC_GA_ID=
