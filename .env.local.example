# =============================================
# Rot Pet Admin - Variables de entorno (template)
# =============================================
# Copiar a .env.local y completar con tus valores.
# NUNCA commitear .env.local — está en .gitignore.

# ─── Modo DB ───────────────────────────────────────────────────────
# "true"  → usar Docker local con Postgres (recomendado para dev)
# "false" → usar Supabase Cloud
USE_LOCAL_DB=true

# ─── Postgres local (Docker) — solo si USE_LOCAL_DB=true ──────────
# El docker-compose.yml define estas credenciales por defecto
DATABASE_URL=postgresql://rotpet:rotpet_secret_2024@localhost:5435/rotpet

# ─── Supabase Cloud — solo si USE_LOCAL_DB=false ──────────────────
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# ─── NextAuth (Auth.js v5) ───────────────────────────────────────
# Generar con: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32-byte-random-string
# En dev local podemos confiar en el host (http://localhost)
AUTH_TRUST_HOST=true

# ─── URLs del sitio ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=

# ─── Email transaccional (Resend) — OPCIONAL ───────────────────────
RESEND_API_KEY=
EMAIL_FROM=Rot Pet Shop <noreply@rot.pet>
SUPPORT_EMAIL=info@rot.pet

# ─── Google Analytics — OPCIONAL ──────────────────────────────────
NEXT_PUBLIC_GA_ID=
